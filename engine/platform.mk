#
# Host detection and the few shell commands the recipes need. Recipes run
# either with a POSIX sh (Linux, macOS, BSD, MSYS2, Git Bash) or with cmd.exe
# (GNU Make launched from a plain Windows console): only the commands below
# differ between the two.

###############################################################################
# Host operating system: Linux, Darwin, FreeBSD, OpenBSD, NetBSD, Windows...
###############################################################################

ifeq ($(OS),Windows_NT)
    HOST_OS := Windows
    # cmd.exe keeps the quotes of echo, sh removes them.
    ifeq ($(shell echo "q"),"q")
        HOST_SHELL := cmd
    else
        HOST_SHELL := sh
    endif
else
    HOST_OS := $(shell uname -s)
    HOST_SHELL := sh
endif

###############################################################################
# Shell commands
###############################################################################

ifeq ($(HOST_SHELL),cmd)
    _mm_winpath = $(subst /,\,$1)
    _mm_devnull := nul
    _mm_noop := rem
    _mm_mkdir = if not exist "$(call _mm_winpath,$1)" mkdir "$(call _mm_winpath,$1)"
    _mm_rmdir = if exist "$(call _mm_winpath,$1)" rmdir /s /q "$(call _mm_winpath,$1)"
    _mm_rm = $(foreach f,$1,if exist "$(call _mm_winpath,$f)" del /f /q "$(call _mm_winpath,$f)" &) rem
    _mm_copy = copy /y "$(call _mm_winpath,$1)" "$(call _mm_winpath,$2)" >nul
    _mm_copydir = xcopy /e /i /q /y "$(call _mm_winpath,$1)" "$(call _mm_winpath,$2)" >nul
    _mm_exec = $(call _mm_winpath,$1)
else
    _mm_winpath = $1
    _mm_devnull := /dev/null
    _mm_noop := :
    _mm_mkdir = mkdir -p $1
    _mm_rmdir = rm -rf $1
    _mm_rm = rm -f $1
    _mm_copy = cp -f $1 $2
    _mm_copydir = mkdir -p $2 && cp -R $1/. $2
    _mm_exec = $(if $(filter /% ./% ../%,$1),$1,./$1)
endif

###############################################################################
# Parallel build by default, unless the user gave -j.
###############################################################################

ifeq ($(HOST_OS),Windows)
    _mm_nprocs := $(or $(NUMBER_OF_PROCESSORS),1)
else
    _mm_nprocs := $(or $(shell getconf _NPROCESSORS_ONLN 2>/dev/null),1)
endif
ifeq ($(findstring j,$(firstword -$(MAKEFLAGS)))$(filter -j%,$(MAKEFLAGS)),)
    MAKEFLAGS += -j$(_mm_nprocs)
endif

# No builtin implicit rules: every rule is generated by MyMakefile.
MAKEFLAGS += --no-builtin-rules
.SUFFIXES:
