###############################################################################
#
# Host detection and the few shell commands the recipes need. Recipes run
# either with a POSIX sh (Linux, macOS, BSD, MSYS2, Git Bash) or with cmd.exe
# (GNU Make launched from a plain Windows console): only the commands below
# differ between the two.

###############################################################################
# Host: HOST_OS is Linux, Darwin, FreeBSD, OpenBSD, NetBSD, Windows...
###############################################################################

ifeq ($(OS),Windows_NT)
    HOST_OS := Windows
    HOST_ARCH := $(if $(filter AMD64,$(PROCESSOR_ARCHITEW6432) $(PROCESSOR_ARCHITECTURE)),x86_64,$(if $(filter ARM64,$(PROCESSOR_ARCHITECTURE)),arm64,x86))
    HOST_EXE := .exe
    # cmd.exe keeps the quotes of echo, sh removes them.
    ifeq ($(shell echo "q"),"q")
        HOST_SHELL := cmd
    else
        HOST_SHELL := sh
    endif
else
    HOST_OS := $(shell uname -s)
    HOST_ARCH := $(shell uname -m)
    HOST_EXE :=
    HOST_SHELL := sh
endif

# Separator of the directories of PATH: ':' everywhere but in a Windows PATH.
PATH_SEP := $(if $(findstring ;,$(PATH)),;,:)

###############################################################################
# Shell commands
###############################################################################

ifeq ($(HOST_SHELL),cmd)
    win-path = $(subst /,\,$1)
    DEVNULL := nul
    NOOP := rem
    make-dir = if not exist "$(call win-path,$1)" mkdir "$(call win-path,$1)"
    remove-dir = if exist "$(call win-path,$1)" rmdir /s /q "$(call win-path,$1)"
    remove-files = $(foreach f,$1,if exist "$(call win-path,$f)" del /f /q "$(call win-path,$f)" &) rem
    copy-files = $(foreach f,$1,copy /y "$(call win-path,$f)" "$(call win-path,$2)" >nul &) rem
    copy-dir = xcopy /e /i /q /y "$(call win-path,$1)" "$(call win-path,$2)" >nul
    run-path = $(call win-path,$1)
    # Environment of one command: "set A=1&& set B=2&& command"
    with-env = $(foreach v,$1,set $v&&) $2
else
    win-path = $1
    DEVNULL := /dev/null
    NOOP := :
    make-dir = mkdir -p $1
    remove-dir = rm -rf $1
    remove-files = rm -f $1
    copy-files = cp -fP $1 $2
    copy-dir = mkdir -p $2 && cp -R $1/. $2
    run-path = $(if $(filter /% ./% ../%,$1),$1,./$1)
    with-env = $(if $1,env $1) $2
endif

###############################################################################
# Parallel build by default, unless the user gave -j.
###############################################################################

ifeq ($(HOST_OS),Windows)
    NPROCS := $(or $(NUMBER_OF_PROCESSORS),1)
else
    NPROCS := $(or $(shell getconf _NPROCESSORS_ONLN 2>/dev/null),1)
endif
ifeq ($(findstring j,$(firstword -$(MAKEFLAGS)))$(filter -j%,$(MAKEFLAGS)),)
    MAKEFLAGS += -j$(NPROCS)
endif

# No builtin implicit rules: every rule is generated by MyMakefile.
MAKEFLAGS += --no-builtin-rules
.SUFFIXES:
