#
# project_info.hpp of the targets having 't.PROJECT_INFO := 1': name, version,
# git commit and data paths of the project, for the C and C++ code. The header
# is rewritten only when one of these values changes. Info.plist of the macOS
# bundles.

INFO_TARGETS := $(strip $(foreach t,$(TARGETS),$(if $($t._INFO),$t)))

ifneq ($(and $(INFO_TARGETS),$(BUILDING)),)
    GIT_SHA1 := $(shell git rev-parse HEAD 2>$(DEVNULL))
    GIT_BRANCH := $(shell git rev-parse --abbrev-ref HEAD 2>$(DEVNULL))
endif

ifeq ($(TARGET_OS),Windows)
    DATA_PATH_SEP := ;
else
    DATA_PATH_SEP := :
endif
TEMP_DIR := $(subst \,/,$(or $(TMPDIR),$(TEMP),/tmp))

#? Data of the user, writable: ~/.local/share/<project> on Linux.
ifeq ($(TARGET_OS),Linux)
    USER_DATADIR ?= $(HOME)/.local/share/$(INSTALL_NAME)
else ifeq ($(TARGET_OS),Windows)
    USER_DATADIR ?= $(subst \,/,$(APPDATA))/$(INSTALL_NAME)
endif

# Where the data of a target are looked for, as in MyMakefile 2: in the
# sources (but in release), then in the data of the user, then where
# 'make install' puts them.
data-paths = $(subst $(SPACE),$(DATA_PATH_SEP),$(strip \
    $(if $(filter $(OPTIMIZED_MODES),$(COMPILATION_MODE)),,$(abspath $($1._DATA))) \
    $(if $($1._DATA),$(USER_DATADIR) $(PROJECT_DATADIR))))

info-signature = $(PROJECT_NAME) $($1.NAME) $(PROJECT_VERSION) $(COMPILATION_MODE) \
    $(GIT_SHA1) $(GIT_BRANCH) $(call data-paths,$1) | $($1.DESCRIPTION)

# The compilation modes of MyMakefile 2 had three values in C++.
info-mode = $(if $(filter debug,$(COMPILATION_MODE)),debug,$(if $(filter normal,$(COMPILATION_MODE)),normal,release))

# Identifier of a target in C++ (OpenGlassBox-demo -> openglassbox_demo) and
# for the macros (OPENGLASSBOX_DEMO).
cxx-identifier = $(call lower,$(subst -,_,$(subst .,_,$(subst /,_,$1))))

#? Header of the targets having 't.PROJECT_INFO := 1', included as
#?   #include "<name>/project_info.hpp"
#? in the build tree and once installed. Its namespace generated::<name>
#? keeps the two headers of an application and of its library apart.
define PROJECT_INFO_HPP
// Generated by MyMakefile from the Makefile of $(PROJECT_NAME): do not edit.
//   #include "$($1.NAME)/project_info.hpp"
#ifndef GENERATED_$(call c-identifier,$($1.NAME))_PROJECT_INFO_HPP
#  define GENERATED_$(call c-identifier,$($1.NAME))_PROJECT_INFO_HPP

// For C and for the preprocessor.
#  define $(call c-identifier,$($1.NAME))_VERSION "$(PROJECT_VERSION)"
#  define $(call c-identifier,$($1.NAME))_VERSION_MAJOR $(call version-field,1,$(PROJECT_VERSION))
#  define $(call c-identifier,$($1.NAME))_VERSION_MINOR $(call version-field,2,$(PROJECT_VERSION))
#  define $(call c-identifier,$($1.NAME))_VERSION_PATCH $(call version-field,3,$(PROJECT_VERSION))
#  define $(call c-identifier,$($1.NAME))_GIT_SHA1 "$(GIT_SHA1)"

#  ifdef __cplusplus

namespace generated {
namespace $(call cxx-identifier,$($1.NAME)) {

//! \brief Project name.
constexpr char name[] = "$(PROJECT_NAME)";

namespace application
{
    //! \brief Name of the target: application or library.
    constexpr char name[] = "$($1.NAME)";
    //! \brief Summary of the target.
    constexpr char summary[] = "$($1.DESCRIPTION)";
    //! \brief Log file name.
    constexpr char log[] = "$($1.NAME).log";
}

namespace version
{
    constexpr char full[] = "$(PROJECT_VERSION)";
    constexpr unsigned major = $(call version-field,1,$(PROJECT_VERSION))u;
    constexpr unsigned minor = $(call version-field,2,$(PROJECT_VERSION))u;
    constexpr unsigned patch = $(call version-field,3,$(PROJECT_VERSION))u;
}

namespace compilation
{
    enum Mode { debug, release, normal };
    //! \brief debug, normal, or release for the optimized modes.
    constexpr Mode mode = $(info-mode);
    //! \brief COMPILATION_MODE: debug, normal, release, size...
    constexpr char name[] = "$(COMPILATION_MODE)";
}

namespace git
{
    constexpr char branch[] = "$(GIT_BRANCH)";
    constexpr char sha1[] = "$(GIT_SHA1)";
}

namespace paths
{
    //! \brief Separator of the directories in 'data'.
    constexpr char separator = '$(DATA_PATH_SEP)';
    //! \brief Directories where the data are looked for.
    constexpr char data[] = "$(call data-paths,$1)";
    //! \brief Location for storing temporary files.
    constexpr char tmp[] = "$(TEMP_DIR)/";
    //! \brief Location of the log file.
    constexpr char log[] = "$(TEMP_DIR)/$($1.NAME).log";
}

} // namespace $(call cxx-identifier,$($1.NAME))
} // namespace generated

#  endif // __cplusplus
#endif
endef

define INFO_STAMP
ifneq ($$(call read-stamp,$$($(1)._INFO_STAMP)),$$(strip $$(call info-signature,$(1))))
    $$(call write-stamp,$$($(1)._INFO_STAMP),$$(strip $$(call info-signature,$(1))))
endif
endef

ifneq ($(BUILDING),)
    $(foreach t,$(INFO_TARGETS),$(eval $(call INFO_STAMP,$t)))
endif

###############################################################################
# Info.plist of the macOS bundles ('t.BUNDLE := 1', 't.ICON := app.icns').
###############################################################################

define INFO_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$($1.NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(or $($1.BUNDLE_ID),com.$(call lower,$(PROJECT_NAME)).$($1.NAME))</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$($1.NAME)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>$(if $($1._ICON),
    <key>CFBundleIconFile</key>
    <string>$($1.NAME).icns</string>)
</dict>
</plist>
endef
