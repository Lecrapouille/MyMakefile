#
# project_info.hpp of the targets having 't.PROJECT_INFO := 1': name, version,
# git commit and data paths of the project, for the C++ code. The header is
# rewritten only when one of these values changes.

_mm_info_targets := $(foreach t,$(TARGETS),$(if $($t._INFO),$t))

ifneq ($(and $(_mm_info_targets),$(_mm_building)),)
    _mm_git_sha1 := $(shell git rev-parse HEAD 2>$(_mm_devnull))
    _mm_git_branch := $(shell git rev-parse --abbrev-ref HEAD 2>$(_mm_devnull))
endif

ifeq ($(TARGET_OS),Windows)
    _mm_path_sep := ;
else
    _mm_path_sep := :
endif
_mm_tmpdir := $(subst \,/,$(or $(TMPDIR),$(TEMP),/tmp))

# Where the data of a target are looked for: in the sources (except in
# release), then where 'make install' puts them.
_mm_data_paths = $(subst $(_mm_space),$(_mm_path_sep),$(strip \
    $(if $(filter release,$(COMPILATION_MODE)),,$(abspath $($1._DATA))) \
    $(if $($1._DATA),$(PREFIX)/share/$(PROJECT_NAME))))

_mm_info_sig = $(PROJECT_NAME) $($1.NAME) $(PROJECT_VERSION) $(COMPILATION_MODE) \
    $(_mm_git_sha1) $(_mm_git_branch) $(call _mm_data_paths,$1) | $($1.DESCRIPTION)

define _mm_project_info_hpp
// Generated by MyMakefile: do not edit.
#ifndef $(call _mm_cid,$(PROJECT_NAME)_$($1.NAME))_PROJECT_INFO_HPP
#  define $(call _mm_cid,$(PROJECT_NAME)_$($1.NAME))_PROJECT_INFO_HPP

#  include <cstdint>
#  include <string>

namespace project {
namespace info
{
    //! \brief Project name.
    const std::string name{"$(PROJECT_NAME)"};

    namespace application
    {
        //! \brief Application name.
        const std::string name{"$($1.NAME)"};
        //! \brief Summary of the application.
        const std::string summary{"$($1.DESCRIPTION)"};
        //! \brief Log file name.
        const std::string log{"$($1.NAME).log"};
    }

    namespace version
    {
        const std::string full{"$(PROJECT_VERSION)"};
        const uint32_t major{$(call _mm_version_field,1,$(PROJECT_VERSION))u};
        const uint32_t minor{$(call _mm_version_field,2,$(PROJECT_VERSION))u};
        const uint32_t patch{$(call _mm_version_field,3,$(PROJECT_VERSION))u};
    }

    namespace compilation
    {
        enum Mode { debug, release, normal };
        //! \brief Compiled in debug, normal or release mode.
        const Mode mode{project::info::compilation::$(COMPILATION_MODE)};
    }

    namespace git
    {
        const std::string branch{"$(_mm_git_branch)"};
        const std::string sha1{"$(_mm_git_sha1)"};
    }

    namespace paths
    {
        //! \brief Separator of the directories in 'data'.
        const char separator{'$(_mm_path_sep)'};
        //! \brief Directories where the data of the project are looked for.
        const std::string data{"$(call _mm_data_paths,$1)"};
        //! \brief Location for storing temporary files.
        const std::string tmp{"$(_mm_tmpdir)/"};
        //! \brief Location of the log file.
        const std::string log{"$(_mm_tmpdir)/$($1.NAME).log"};
    }
}
}

#endif
endef

define _mm_info_stamp
ifneq ($$(call _mm_read_stamp,$$($(1)._GENDIR)/info.txt),$$(strip $$(call _mm_info_sig,$(1))))
    $$(call _mm_write_stamp,$$($(1)._GENDIR)/info.txt,$$(strip $$(call _mm_info_sig,$(1))))
endif
endef

ifneq ($(_mm_building),)
    $(foreach t,$(_mm_info_targets),$(eval $(call _mm_info_stamp,$t)))
endif
